# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/gruasdelnorte"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET="cambia_esto_por_un_secreto_largo_y_aleatorio"

# ─── Redis (opcional — el servidor arranca sin Redis) ────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Google Maps (para cálculo de ETA y distancias) ─────────────────────────
GOOGLE_MAPS_API_KEY="AIza..."

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Descarga el JSON de Firebase Console → Configuración del proyecto → Cuentas de servicio
FIREBASE_CREDENTIALS_PATH="./firebase-adminsdk.json"

# ─── Puerto ───────────────────────────────────────────────────────────────────
PORT=3000
